{
  "manifest_version": 2,
  "name": "RutaMusica puente",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "ytbridge@rutamusica.app" } },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/embed/*", "https://www.youtube-nocookie.com/embed/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"]
}
